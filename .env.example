# Email (existing)
RESEND_API_KEY=
SEND_TO=

# Google Business reviews export script (existing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Database (Neon Postgres) — residential signup/checkout feature
DATABASE_URL=

# Stripe — residential signup/checkout feature
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mapbox — service-area geocoding (server-only secret token, starts with sk.)
MAPBOX_SECRET_TOKEN=

# Mapbox — client-side address autocomplete on the /signup form (public
# token, starts with pk. — safe to expose in the browser by design, but
# restrict it to your domain in the Mapbox dashboard). Separate token from
# MAPBOX_SECRET_TOKEN above; the secret token must never be used here.
NEXT_PUBLIC_MAPBOX_TOKEN=

# HMAC key signing the admin approve/reject email links — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_ACTION_SECRET=

# Admin dashboard (/admin) — single shared login for office staff.
# ADMIN_PASSWORD is the shared password (plain text here, but compared with
# a timing-safe check at login — not stored anywhere else).
# ADMIN_SESSION_SECRET signs the login session cookie — generate the same
# way as ADMIN_ACTION_SECRET above, but keep it a DIFFERENT value, so
# rotating it (to force everyone to log in again) doesn't invalidate any
# in-flight email action links.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Absolute site URL, no trailing slash — used to build Stripe success/cancel
# URLs and the admin verification links sent by email
NEXT_PUBLIC_SITE_URL=https://www.enchantmentdisposal.com
